# Copy this file to "keystore.properties" (same directory, project root) and fill in your
# real values. keystore.properties itself is git-ignored — never commit real secrets.
#
# Alternative: instead of this file, you can set these as environment variables:
#   FINTRACK_KEYSTORE_PATH, FINTRACK_KEYSTORE_PASSWORD, FINTRACK_KEY_ALIAS, FINTRACK_KEY_PASSWORD
# (useful for CI, where you don't want a properties file on disk at all).

storeFile=my-release-key.jks
storePassword=CHANGE_ME
keyAlias=my-key-alias
keyPassword=CHANGE_ME
